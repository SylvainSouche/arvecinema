{
  "name": "arvecinema",
  "version": "0.2.1",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "debug": "ARVE_DEBUG=1 electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "format": "prettier --write \"src/**/*.{ts,tsx,html,css,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,html,css,json}\"",
    "bump": "node -e \"const p=require('./package.json');const v=p.version.split('.');v[2]=String(Number(v[2])+1);require('fs').writeFileSync('./package.json',JSON.stringify({...p,version:v.join('.')},null,2)+'\\n');console.log('Version bumped to '+v.join('.'))\"",
    "package": "npm run bump && electron-vite build && electron-builder",
    "package:dir": "npm run bump && electron-vite build && electron-builder --dir",
    "package:dmg": "npm run bump && electron-vite build && electron-builder --mac dmg",
    "package:zip": "npm run bump && electron-vite build && electron-builder --mac zip"
  },
  "build": {
    "appId": "fr.arvecinema.app",
    "productName": "ArveCinema",
    "directories": { "output": "dist" },
    "files": ["out/**/*", "package.json"],
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.entertainment",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "target": [
        { "target": "dmg", "arch": ["x64", "arm64"] },
        { "target": "zip", "arch": ["x64", "arm64"] }
      ]
    },
    "win": {
      "icon": "build/icon.ico",
      "target": ["nsis"]
    },
    "linux": {
      "icon": "build/icon-512.png",
      "target": ["AppImage"],
      "category": "AudioVideo"
    },
    "extraResources": [
      { "from": "build/icon.png", "to": "icon.png" }
    ]
  },
  "dependencies": {
    "cheerio": "^1.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.0.0",
    "prettier": "^3.3.3",
    "typescript": "^5.3.0",
    "vite": "^5.0.0"
  }
}
