{
  "name": "arvecinema",
  "version": "0.14.10",
  "description": "Cinema showtimes app for the Arve Valley (Sallanches, Cluses, Bonneville, Chamonix)",
  "license": "BSD-3-Clause",
  "author": "ArveCinema contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/SylvainSouche/arvecinema.git"
  },
  "homepage": "https://github.com/SylvainSouche/arvecinema",
  "bugs": {
    "url": "https://github.com/SylvainSouche/arvecinema/issues"
  },
  "keywords": [
    "electron",
    "cinema",
    "showtimes",
    "mont-blanc",
    "arve",
    "allocine",
    "wikidata"
  ],
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "npm run rebuild:electron && electron-vite dev",
    "debug": "npm run rebuild:electron && ARVE_DEBUG=1 electron-vite dev",
    "build": "npm run rebuild:electron && electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run rebuild:node && vitest run",
    "test:watch": "npm run rebuild:node && vitest",
    "test:coverage": "npm run rebuild:node && vitest run --coverage",
    "rebuild:node": "npm rebuild better-sqlite3 --quiet",
    "rebuild:electron": "electron-builder install-app-deps",
    "test:e2e": "bash scripts/run-e2e.sh",
    "test:e2e:headed": "bash scripts/run-e2e.sh --headed",
    "record": "bash scripts/capture-network.sh",
    "replay": "ARVE_REPLAY=test/fixtures/network-capture.json bash scripts/run-e2e.sh",
    "help": "bash scripts/help.sh",
    "format": "prettier --write \"src/**/*.{ts,tsx,html,css,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,html,css,json}\"",
    "package": "electron-vite build && electron-builder",
    "package:dir": "electron-vite build && electron-builder --dir",
    "package:dmg": "electron-vite build && electron-builder --mac dmg"
  },
  "build": {
    "appId": "fr.arvecinema.app",
    "productName": "ArveCinema",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asar": true,
    "compression": "maximum",
    "removePackageScripts": true,
    "removePackageKeywords": true,
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.entertainment",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ]
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "icon": "build/icon-256.png",
      "target": [
        "AppImage"
      ],
      "category": "AudioVideo"
    },
    "extraResources": [
      {
        "from": "build/icon-64.png",
        "to": "icon.png"
      }
    ]
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "cheerio": "^1.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "electron-vite": "^2.0.0",
    "prettier": "^3.3.3",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vitest": "^1.6.1"
  }
}
