// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`snapshot: LogViewer > initial shell (empty log store — effects do not run in a static render) 1`] = `"<div style="display:flex;flex-direction:column;height:100%"><div style="display:flex;align-items:center;gap:8px;margin-bottom:8px;flex-wrap:wrap"><div style="display:flex;gap:4px"><button style="padding:4px 10px;border-radius:var(--radius-sm);border:1px solid var(--border-light);background:var(--bg-pill);color:var(--text-primary);cursor:pointer;font-size:var(--text-base);border-color:var(--border-light)">Tous (0)</button><button style="padding:4px 10px;border-radius:var(--radius-sm);border:1px solid var(--border-light);background:transparent;color:var(--text-muted);cursor:pointer;font-size:var(--text-base)">⚠ 0</button><button style="padding:4px 10px;border-radius:var(--radius-sm);border:1px solid var(--border-light);background:transparent;color:var(--text-muted);cursor:pointer;font-size:var(--text-base)">✗ 0</button></div><input type="text" placeholder="Filtrer les messages…" style="flex:1;min-width:120px;padding:4px 8px;border-radius:var(--radius-sm);border:1px solid var(--border-light);background:var(--bg-input);color:var(--text-primary);font-size:var(--text-base)" value=""/><select style="padding:4px 8px;border-radius:var(--radius-sm);border:1px solid var(--border-light);background:var(--bg-input);color:var(--text-primary);font-size:var(--text-base)"><option value="" selected="">Tous les composants</option></select><label style="font-size:var(--text-sm);color:var(--text-muted);display:flex;align-items:center;gap:4px"><input type="checkbox" checked=""/>Défilement auto</label><button style="padding:4px 10px;border-radius:var(--radius-sm);border:1px solid var(--border-light);background:transparent;color:var(--text-muted);cursor:pointer;font-size:var(--text-base)">⤓ Exporter</button><button style="padding:4px 10px;border-radius:var(--radius-sm);border:1px solid var(--border-light);background:transparent;color:var(--text-muted);cursor:pointer;font-size:var(--text-base)">Effacer</button></div><div style="flex:1;overflow:auto;background:var(--bg-card-2);border-radius:var(--radius-md);border:1px solid var(--border);padding:8px;font-family:ui-monospace, &quot;SF Mono&quot;, &quot;Cascadia Mono&quot;, Menlo, Consolas, monospace;font-size:var(--text-sm);line-height:1.5;min-height:200px"><div style="color:var(--text-faint);text-align:center;padding:20px">Aucune entrée de log</div></div></div>"`;

exports[`snapshot: MovieCard > blocked-rating state renders the red ⚠ badge (not silent absence) 1`] = `"<div style="display:flex;gap:20px;padding:16px;background:var(--bg-card);border-radius:var(--radius-xl);border:1px solid var(--border);align-items:flex-start"><div style="flex:0 0 110px;width:110px;aspect-ratio:2 / 3;background:var(--bg-card-2);border-radius:var(--radius-lg);overflow:hidden;position:relative"><div style="position:absolute;inset:0;display:flex;align-items:center;justify-content:center;color:var(--text-faint);font-size:var(--text-sm);text-align:center;padding:8px">Pas d&#x27;affiche</div></div><div style="flex:1;min-width:0;display:flex;flex-direction:column;gap:6px"><h3 style="margin:0;font-size:var(--text-2xl);color:var(--text-primary);font-weight:var(--weight-extrabold);line-height:1.2;letter-spacing:-0.2px">Le Comte de Monte-Cristo<span style="font-size:var(--text-lg);font-weight:var(--weight-normal);color:var(--text-muted);margin-left:8px">2099</span></h3><div style="display:flex;gap:6px;margin-top:2px;align-items:center;flex-wrap:wrap"><span style="background:#e11d48;color:var(--text-primary);padding:2px 9px;border-radius:var(--radius-sm);font-size:var(--text-sm);font-weight:var(--weight-bold);letter-spacing:0.3px">Cinéma Château Rouge · Cluses</span></div><div style="display:flex;gap:8px;margin-top:2px;align-items:center;flex-wrap:wrap"><span style="background:var(--text-primary);color:var(--bg-card);padding:2px 9px;border-radius:var(--radius-sm);font-size:var(--text-sm);font-weight:var(--weight-bold);letter-spacing:0.3px">VF</span><span style="background:transparent;color:var(--text-primary);padding:2px 9px;border-radius:var(--radius-sm);font-size:var(--text-sm);font-weight:var(--weight-bold);letter-spacing:0.3px;border:1px solid var(--text-primary)">VO</span><span style="color:var(--text-muted);font-size:var(--text-sm)">· Aventure, Drame</span><span style="color:var(--text-dim);font-size:var(--text-sm)">· 178 min</span><a href="https://www.imdb.com/title/tt22084616/" title="IMDB — Cliquez pour ouvrir la fiche IMDB" style="background:rgba(245,197,24,0.05);border:1px solid rgba(245,197,24,0.15);border-radius:var(--radius-sm);padding:2px 8px;font-size:var(--text-sm);font-weight:var(--weight-semibold);cursor:pointer;display:inline-flex;align-items:center;gap:2px"><span aria-hidden="true" style="opacity:0.5">⭐</span><span style="color:rgba(245,197,24,0.5);font-size:var(--text-xs)">…</span></a><span title="RT — Échec de récupération" style="display:inline-flex;align-items:center;gap:2px;font-size:var(--text-xs);color:var(--text-secondary);padding:2px 4px;border:1px dashed rgba(229, 9, 20, 0.4);border-radius:var(--radius-sm)"><span style="font-size:var(--text-xs)">RT</span><span style="width:6px;height:6px;border-radius:50%;background:var(--brand-error);display:inline-block"></span><span style="font-size:var(--text-xs);opacity:0.7">⚠</span></span></div><div style="color:var(--text-secondary);font-size:var(--text-md);line-height:1.45;margin-top:4px"><div><strong style="color:var(--text-primary);font-weight:var(--weight-semibold)">Réalisation :</strong> Alexandre de La Patellière</div><div><strong style="color:var(--text-primary);font-weight:var(--weight-semibold)">Avec :</strong> Pierre Niney, Anamaria Vartolomei</div></div><p style="margin:6px 0 0;color:var(--text-muted);font-size:var(--text-base);line-height:1.5;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden">Un jeune marin est injustement emprisonné. Escape. Revenge.</p><div style="margin-top:8px"><div style="display:flex;gap:8px;flex-wrap:wrap"><button type="button" disabled="" style="padding:6px 12px;border-radius:var(--radius-md);background:var(--bg-pill);color:var(--text-primary);border:1px solid #e11d4840;font-size:var(--text-md);font-weight:var(--weight-semibold);display:inline-flex;align-items:center;gap:6px;cursor:default" title="Cinéma Château Rouge"><span aria-hidden="true" style="width:8px;height:8px;border-radius:50%;background:#e11d48;display:inline-block"></span>18h30<span style="opacity:0.95;font-size:var(--text-xs);background:rgba(0,0,0,0.45);padding:1px 5px;border-radius:var(--radius-sm);font-weight:var(--weight-bold)">VF</span></button><button type="button" disabled="" style="padding:6px 12px;border-radius:var(--radius-md);background:var(--bg-pill);color:var(--text-primary);border:1px solid #e11d4840;font-size:var(--text-md);font-weight:var(--weight-semibold);display:inline-flex;align-items:center;gap:6px;cursor:default" title="Cinéma Château Rouge"><span aria-hidden="true" style="width:8px;height:8px;border-radius:50%;background:#e11d48;display:inline-block"></span>20h45<span style="opacity:0.95;font-size:var(--text-xs);background:rgba(0,0,0,0.45);padding:1px 5px;border-radius:var(--radius-sm);font-weight:var(--weight-bold)">VO</span></button></div></div></div></div>"`;

