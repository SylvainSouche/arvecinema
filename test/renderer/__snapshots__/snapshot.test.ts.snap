exports[`snapshot: WeekGrid > empty grid (no movies → header still renders the day columns) 1`] = `"<div style="padding:40px;text-align:center;color:var(--text-muted)">Aucun film ne correspond à ces filtres.</div>"`;

exports[`snapshot: WeekGrid > full grid (2 films × multiple showtimes, 18h–22h focus window) 1`] = `
"<div style="overflow:scroll;height:100%;position:relative;cursor:grab;background:var(--bg-primary);user-select:none"><div style="min-width:1324px;position:relative"><div style="display:flex;position:sticky;top:0;z-index:5"><div style="flex:0 0 300px;position:sticky;left:0;z-index:6;background:var(--bg-primary);padding:10px 14px;border-bottom:1px solid var(--border-light);font-size:var(--text-sm);color:var(--text-muted);font-weight:var(--weight-semibold);letter-spacing:0.3px;text-transform:uppercase">2 films</div><div style="display:flex"><div style="display:flex"><div style="width:56px;flex:0 0 56px;position:relative;background:var(--bg-strip-dim);border-bottom:1px solid var(--border-light)"><div style="font-size:var(--text-sm);color:var(--text-primary);text-transform:capitalize;font-weight:var(--weight-bold);padding:6px 0 2px;text-align:center">dim 12</div><div style="position:absolute;bottom:10px;left:0;transform:translateX(-50%);font-size:var(--text-sm);font-weight:400;color:var(--text-faint);white-space:nowrap">16h</div><div style="position:absolute;top:0;bottom:0;left:0;width:3px;background:var(--text-muted)"></div></div><div style="width:56px;flex:0 0 56px;position:relative;background:var(--bg-strip-dim);border-bottom:1px solid var(--border-light)"><div style="position:absolute;bottom:10px;left:0;transform:translateX(-50%);font-size:var(--text-sm);font-weight:400;color:var(--text-faint);white-space:nowrap">17h</div><div style="position:absolute;top:0;bottom:0;left:0;width:1px;background:var(--border-light)"></div></div><div style="width:56px;flex:0 0 56px;position:relative;background:var(--bg-strip-active);border-bottom:1px solid var(--border-light)"><div style="position:absolute;bottom:10px;left:0;transform:translateX(-50%);font-size:var(--text-sm);font-weight:600;color:var(--text-secondary);white-space:nowrap">18h</div><div style="position:absolute;top:0;bottom:0;left:0;width:1px;background:var(--border-light)"></div></div><div style="width:56px;flex:0 0 56