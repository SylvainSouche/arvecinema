ne-block"></span>18h30<span style="opacity:0.95;font-size:var(--text-xs);background:rgba(0,0,0,0.45);padding:1px 5px;border-radius:var(--radius-sm);font-weight:var(--weight-bold)">VF</span></button><button type="button" disabled="" style="padding:6px 12px;border-radius:var(--radius-md);background:var(--bg-pill);color:var(--text-primary);border:1px solid #e11d4840;font-size:var(--text-md);font-weight:var(--weight-semibold);display:inline-flex;align-items:center;gap:6px;cursor:default" title="Cinéma Château Rouge"><span aria-hidden="true" style="width:8px;height:8px;border-radius:50%;background:#e11d48;display:inline-block"></span>20h45<span style="opacity:0.95;font-size:var(--text-xs);background:rgba(0,0,0,0.45);padding:1px 5px;border-radius:var(--radius-sm);font-weight:var(--weight-bold)">VO</span></button></div></div></div></div>"`;

